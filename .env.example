# Copy this file to ".env" and fill in your keys. Do NOT commit the real .env.

# RentCast — free tier: 50 API calls/month, no credit card
# https://app.rentcast.io/app/api
RENTCAST_API_KEY=

# ATTOM — 30-day free TRIAL only, then paid. Optional (school data + 2nd-opinion AVM)
# https://api.developer.attomdata.com/signup
ATTOM_API_KEY=

# Google Distance Matrix — true peak-traffic commute times (needs a billing account;
# free monthly credit covers low volume). Optional.
GOOGLE_MAPS_API_KEY=

# OpenRouteService — free fallback router (OFF-PEAK estimates only, no live traffic)
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
